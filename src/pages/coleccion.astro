---
import Layout from '../layouts/Layout.astro';
import AchievementGallery from '../components/AchievementGallery.astro';
---

<Layout title="Mi Colección - Hipnos" wide>
  <header class="header" slot="header">
    <a href="/" class="back-link">← Volver a Hipnos</a>
    <h1 class="main-title">Logros</h1>
    <p class="subtitle">Los logros que has desbloqueado en tus viajes oníricos</p>
  </header>

  <AchievementGallery />

  <script>
    import '../functions/collectibles.js';
  </script>

  <style>
    .main-title {
      font-size: 3rem;
    }

    .back-link {
      position: absolute;
      top: 1rem;
      left: 0;
      color: #a390ff;
      text-decoration: none;
      font-size: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.3s ease;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      background: rgba(163, 148, 255, 0.1);
      border: 1px solid rgba(163, 148, 255, 0.2);
      z-index: 10;
      cursor: pointer;
    }

    .back-link:hover {
      background: rgba(163, 148, 255, 0.2);
      border-color: rgba(163, 148, 255, 0.4);
      transform: translateX(-5px);
      color: #ffd700;
    }

    @media (max-width: 768px) {
      .main-title {
        font-size: 2rem;
      }

      .back-link {
        position: relative;
        top: 0;
        left: 0;
        margin-bottom: 1rem;
        display: inline-flex;
      }
    }
  </style>
</Layout>
