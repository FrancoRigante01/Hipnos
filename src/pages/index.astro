---
import Layout from '../layouts/Layout.astro';
import DreamInput from '../components/DreamInput.astro';
import DreamResult from '../components/DreamResult.astro';
import DreamGallery from '../components/DreamGallery.astro';
import FloatingCollectionButton from '../components/FloatingCollectionButton.astro';
---

<Layout title="Hipnos">
  <header class="header" slot="header">
    <h1 class="main-title">Hipnos</h1>
    <p class="subtitle">Yo, guardián de los sueños, interpreto tus visiones nocturnas</p>
  </header>

  <DreamInput />
  <DreamResult />
  <DreamGallery />

  <Fragment slot="floating">
    <FloatingCollectionButton />
  </Fragment>

  <script>
    import '../functions/voiceRecognition.js';
    import '../functions/collectibles.js';
    import '../functions/dreamApp.js';
  </script>
</Layout>
